<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SystemCtrl.Desktop.App"
             xmlns:local="using:SystemCtrl.Desktop"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <StyleInclude Source="avares://SystemCtrl.Desktop/Assets/Icons.axaml" />
        <StyleInclude Source="avares://SystemCtrl.Desktop/Styles/Colors.axaml" />
        
        <StyleInclude Source="avares://SystemCtrl.Desktop/Styles/Controls/Buttons.axaml" />

        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light"
                                       Accent="{StaticResource PrimaryColor}"
                                       AltHigh="{StaticResource CardColor}"
                                       AltLow="{StaticResource BackgroundColor}"
                                       AltMedium="{StaticResource SidebarColor}"
                                       AltMediumHigh="{StaticResource CardColor}"
                                       AltMediumLow="{StaticResource AltMediumLowColor}"
                                       BaseHigh="{StaticResource ForegroundColor}"
                                       BaseLow="{StaticResource SecondaryColor}"
                                       BaseMedium="{StaticResource MutedForegroundColor}"
                                       BaseMediumHigh="{StaticResource BaseMediumHighColor}"
                                       BaseMediumLow="{StaticResource BaseMediumLowColor}"
                                       ChromeAltLow="{StaticResource ForegroundColor}"
                                       ChromeBlackHigh="{StaticResource BorderColor}"
                                       ChromeBlackLow="{StaticResource ChromeBlackLowColor}"
                                       ChromeBlackMedium="{StaticResource ChromeBlackMediumColor}"
                                       ChromeBlackMediumLow="{StaticResource ChromeBlackMediumLowColor}"
                                       ChromeDisabledHigh="{StaticResource ChromeDisabledHighColor}"
                                       ChromeDisabledLow="{StaticResource ChromeDisabledLowColor}"
                                       ChromeGray="{StaticResource ChromeGrayColor}"
                                       ChromeHigh="{StaticResource RingColor}"
                                       ChromeLow="{StaticResource BackgroundColor}"
                                       ChromeMedium="{StaticResource AccentColor}"
                                       ChromeMediumLow="{StaticResource SecondaryColor}"
                                       ChromeWhite="{StaticResource CardColor}"
                                       ListLow="{StaticResource SecondaryColor}"
                                       ListMedium="{StaticResource RingColor}"
                                       RegionColor="{StaticResource BackgroundColor}"
                                       ErrorText="{StaticResource DestructiveColor}" />
            </FluentTheme.Palettes>
        </FluentTheme>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="Outfit">avares://SystemCtrl.Desktop/Assets/Fonts#Outfit</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">avares://SystemCtrl.Desktop/Assets/Fonts#Outfit</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>