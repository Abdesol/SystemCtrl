<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SystemCtrl.Desktop.ViewModels"
             x:Class="SystemCtrl.Desktop.Controls.SlidePanel"
             x:DataType="vm:SlidePanelViewModel">

    <UserControl.Styles>
        <Style Selector="Border#DimOverlay">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseInOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border#DimOverlay.Open">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
    </UserControl.Styles>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border x:Name="DimOverlay"
                Classes.Open="{Binding IsOpen}"
                Background="{DynamicResource FreezeBackgroundBrush}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                DoubleTapped="DimOverlay_DoubleTapped" />
        <Border x:Name="PanelRoot"
                Width="420"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="{DynamicResource CardBackgroundBrush}"
                BoxShadow="-8 0 40 0 #1A000000"
                CornerRadius="16,0,0,16">
            <Grid RowDefinitions="Auto, *"
                  Margin="20,0">
                <Grid Grid.Row="0"
                      ColumnDefinitions="Auto, *"
                      Margin="0,32,0,20">
                    <Button Grid.Column="0"
                            VerticalAlignment="Center"
                            Command="{Binding CloseCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Height="10"
                                  Data="{StaticResource ChevronLeftIcon}"
                                  Fill="{DynamicResource SystemBaseHighColor}"
                                  Stretch="Uniform" />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource SystemBaseHighColor}"
                                       Text="Back" />
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="1" Text="{Binding Title}"
                               VerticalAlignment="Center"
                               Margin="18,0,0,0"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </Grid>
                <ContentControl Grid.Row="1"
                                Margin="-20, 0"
                                Content="{Binding Content}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
            </Grid>
        </Border>
    </Grid>
</UserControl>