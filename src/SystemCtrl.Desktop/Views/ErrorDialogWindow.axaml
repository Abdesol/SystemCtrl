<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SystemCtrl.Desktop.ViewModels"
        x:DataType="vm:ErrorDialogViewModel"
        x:Class="SystemCtrl.Desktop.Views.ErrorDialogWindow"
        Title="Error"
        Width="520"
        MinHeight="300"
        MaxHeight="600"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource SystemRegionBrush}">

    <Window.Styles>
        <Style Selector="Button.copy-btn">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseHighColor}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.copy-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}" />
        </Style>
        <Style Selector="Button.close-btn">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Styles>

    <Panel Margin="{Binding $parent[Window].OffScreenMargin}">
        <Grid RowDefinitions="Auto, *, Auto">
            <Border Grid.Row="0"
                    Padding="20,16">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <Border Grid.Column="0"
                            Width="36" Height="36"
                            CornerRadius="18"
                            Background="{DynamicResource DangerForegroundBrush}"
                            Margin="0,0,14,0">
                        <TextBlock Text="!"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   Text="{Binding Title}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DangerForegroundBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="MessageText"
                                   Text="{Binding Message}"
                                   IsVisible="{Binding HasMessage}"
                                   FontSize="12"
                                   Foreground="{DynamicResource DangerForegroundBrush}"
                                   Opacity="0.8"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="16,12,16,0"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                <ScrollViewer
                    Classes="DefaultPadding"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto"
                    MaxHeight="320">
                    <SelectableTextBlock x:Name="DetailText"
                                         Text="{Binding Detail}"
                                         FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                                         FontSize="11"
                                         Margin="12"
                                         Padding="3"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource SystemBaseMediumHighColor}"
                                         LineHeight="18" />
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="2"
                  ColumnDefinitions="*, Auto, 8, Auto"
                  Margin="16,12,16,16">
                <Button Grid.Column="1"
                        x:Name="CopyButton"
                        Classes="copy-btn"
                        Command="{Binding CopyCommand}"
                        Width="160">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon x:Name="CopyIcon"
                                  IsVisible="{Binding IsCopyIconVisible}"
                                  Data="{StaticResource CopyIcon}"
                                  Width="13" Height="13" />
                        <TextBlock x:Name="CopyButtonText" Text="{Binding CopyButtonText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3"
                        Classes="close-btn"
                        Command="{Binding CloseCommand}"
                        Content="Close" />
            </Grid>
        </Grid>
    </Panel>
</Window>