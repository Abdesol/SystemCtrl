<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SystemCtrl.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="clr-namespace:SystemCtrl.Desktop.Behaviors"
        xmlns:controls="clr-namespace:SystemCtrl.Desktop.Controls"
        xmlns:sp="clr-namespace:System.ServiceProcess;assembly=System.ServiceProcess.ServiceController"
        xmlns:ts="clr-namespace:Microsoft.Win32.TaskScheduler;assembly=Microsoft.Win32.TaskScheduler"
        xmlns:conv="using:SystemCtrl.Desktop.Converters"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SystemCtrl.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SystemCtrl"
        ExtendClientAreaToDecorationsHint="True"
        MinHeight="400"
        MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <conv:EqualityConverter x:Key="EqualityConverter" />
    </Window.Resources>

    <Panel Margin="{Binding $parent[Window].OffScreenMargin}"
           VerticalAlignment="Stretch"
           HorizontalAlignment="Stretch">
        
        <Panel.Styles>
            <Style Selector="Button.TabButton">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style Selector="Button.TabButton.Active">
                <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SystemBaseHighColor}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </Panel.Styles>
        <Grid RowDefinitions="Auto, Auto, Auto, *"
              Margin="15,12">

            <!-- TITLE BAR -->
            <Grid Row="0"
                  Background="Transparent"
                  HorizontalAlignment="Stretch"
                  PointerPressed="ChangeWindowPosition">
                <TextBlock HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           TextAlignment="Left"
                           Text="SystemCtrl"
                           FontWeight="SemiBold"
                           FontSize="20" />
            </Grid>

            <!-- TAB BAR -->
            <Grid Row="1"
                  Margin="0,16,0,0"
                  HorizontalAlignment="Left">
                <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                        CornerRadius="10"
                        Padding="3">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Classes="TabButton SmallScale"
                                Classes.Active="{Binding ActiveTab, Converter={StaticResource EqualityConverter}, ConverterParameter=0}"
                                Command="{Binding SetActiveTabCommand}"
                                CommandParameter="0">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Viewbox Height="14">
                                    <Path Data="{StaticResource ServicesIcon}"
                                          Fill="{Binding $parent[Button].Foreground}"
                                          Stretch="Uniform" />
                                </Viewbox>
                                <TextBlock Text="Services" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="TabButton SmallScale"
                                Classes.Active="{Binding ActiveTab, Converter={StaticResource EqualityConverter}, ConverterParameter=1}"
                                Command="{Binding SetActiveTabCommand}"
                                CommandParameter="1">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Viewbox Height="14">
                                    <Path Data="{StaticResource SchedulerIcon}"
                                          Fill="{Binding $parent[Button].Foreground}"
                                          Stretch="Uniform" />
                                </Viewbox>
                                <TextBlock Text="Task Scheduler" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- SEARCH + ACTIONS BAR -->
            <Grid Row="2"
                  Margin="0,12,0,0"
                  HorizontalAlignment="Stretch"
                  ColumnDefinitions="*, Auto">
                <Grid Column="0" HorizontalAlignment="Stretch">
                    <TextBox Text="{Binding SearchText}"
                             PlaceholderText="{Binding SearchPlaceholder}"
                             CornerRadius="8"
                             BorderThickness="0"
                             Padding="10,8"
                             Height="36"
                             Margin="0,0,15,0"
                             Background="{DynamicResource CardBackgroundBrush}"
                             VerticalAlignment="Center">
                        <TextBox.InnerLeftContent>
                            <Viewbox Height="16" Margin="12,0,8,0">
                                <Path Data="{StaticResource SearchIcon}"
                                      Fill="{DynamicResource SystemBaseMediumColor}"
                                      Stretch="Uniform"/>
                            </Viewbox>
                        </TextBox.InnerLeftContent>
                    </TextBox>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshCommand}">
                        <Viewbox Height="18">
                            <Path Data="{StaticResource RestartIcon}"
                                  Stretch="Uniform"
                                  Fill="{StaticResource SystemBaseHighColor}"/>
                        </Viewbox>
                    </Button>

                    <Button Command="{Binding OpenSettingsCommand}">
                        <Viewbox Height="18">
                            <Path Data="{StaticResource SettingsIcon}"
                                  Stretch="Uniform"
                                  Fill="{StaticResource SystemBaseHighColor}"/>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- LIST AREA -->
            <Panel Grid.Row="3" Margin="0,15,0,0">

                <!-- SERVICES LIST -->
                <ScrollViewer IsVisible="{Binding ActiveTab, Converter={StaticResource EqualityConverter}, ConverterParameter=0}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,0,-15,0">
                    <ItemsControl ItemsSource="{Binding Services}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Top">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid>
                                    <Interaction.Behaviors>
                                        <behaviors:AdaptiveUniformGridBehavior
                                            MinItemWidth="320"
                                            MaxColumns="5" />
                                    </Interaction.Behaviors>
                                </UniformGrid>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Classes="SmallScale"
                                    Height="125"
                                    Background="Transparent"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Command="{Binding OpenServiceCommand}"
                                    Margin="0,0,5,5">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Open"
                                                      Command="{Binding OpenServiceCommand}" />
                                            <MenuItem Header="{Binding PinActionText}"
                                                      Command="{Binding TogglePinCommand}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Border CornerRadius="10"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Background="{StaticResource CardBackgroundBrush}">
                                        <Grid RowDefinitions="Auto, Auto, *, Auto"
                                              Margin="15">
                                            <TextBlock Grid.Row="0"
                                                       Text="{Binding DisplayName}"
                                                       HorizontalAlignment="Stretch"
                                                       TextAlignment="Left"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontWeight="Medium"
                                                       FontSize="15"
                                                       Margin="0,0,24,0" />
                                            <Path Grid.Row="0"
                                                  Data="{StaticResource PinIcon}"
                                                  Fill="{DynamicResource SystemBaseHighColor}"
                                                  Height="16" Width="16"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Top"
                                                  Stretch="Uniform"
                                                  IsVisible="{Binding IsPinned}" />
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding ServiceName}"
                                                       HorizontalAlignment="Stretch"
                                                       TextAlignment="Left"
                                                       FontWeight="Light"
                                                       Foreground="{DynamicResource SystemBaseMediumColor}"
                                                       FontSize="10" />
                                            <Grid Row="2"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  Margin="0,8,0,0">
                                                <TextBlock Text="{Binding Description}"
                                                           HorizontalAlignment="Stretch"
                                                           VerticalAlignment="Stretch"
                                                           TextWrapping="WrapWithOverflow"
                                                           TextTrimming="WordEllipsis"
                                                           TextAlignment="Left"
                                                           Foreground="{DynamicResource SystemBaseMediumColor}"
                                                           FontSize="13" />
                                            </Grid>
                                            <StackPanel Grid.Row="3"
                                                        Spacing="6"
                                                        Orientation="Horizontal"
                                                        Margin="0,8,0,0"
                                                        HorizontalAlignment="Stretch">
                                                <StackPanel.Styles>
                                                    <Style Selector="Border.IsStopped">
                                                        <Setter Property="Background" Value="{DynamicResource DangerBackgroundBrush}" />
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                                                    </Style>
                                                    <Style Selector="Border.IsRunning">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
                                                    </Style>
                                                    <Style Selector="Border.IsStartPending, Border.IsContinuePending">
                                                        <Setter Property="Background" Value="{DynamicResource InfoBackgroundBrush}" />
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource InfoForegroundBrush}" />
                                                    </Style>
                                                    <Style Selector="Border.IsStopPending, Border.IsPausePending">
                                                        <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningForegroundBrush}" />
                                                    </Style>
                                                    <Style Selector="Border.IsPaused">
                                                        <Setter Property="Background" Value="{DynamicResource CautionBackgroundBrush}" />
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource CautionForegroundBrush}" />
                                                    </Style>
                                                    <Style Selector="Border.IsAutomatic">
                                                        <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
                                                    </Style>
                                                    <Style Selector="Border.IsManual">
                                                        <Setter Property="Background" Value="{DynamicResource NeutralBackgroundBrush}" />
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource NeutralForegroundBrush}" />
                                                    </Style>
                                                    <Style Selector="Border.IsDisabled">
                                                        <Setter Property="Background" Value="{DynamicResource DangerBackgroundBrush}" />
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                                                    </Style>
                                                    <Style Selector="Border.IsBoot, Border.IsSystem">
                                                        <Setter Property="Background" Value="{DynamicResource SpecialBackgroundBrush}" />
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource SpecialForegroundBrush}" />
                                                    </Style>
                                                </StackPanel.Styles>

                                                <Border CornerRadius="8"
                                                        Classes.IsStopped="{Binding Status, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static sp:ServiceControllerStatus.Stopped}}"
                                                        Classes.IsStartPending="{Binding Status, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static sp:ServiceControllerStatus.StartPending}}"
                                                        Classes.IsStopPending="{Binding Status, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static sp:ServiceControllerStatus.StopPending}}"
                                                        Classes.IsRunning="{Binding Status, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static sp:ServiceControllerStatus.Running}}"
                                                        Classes.IsContinuePending="{Binding Status, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static sp:ServiceControllerStatus.ContinuePending}}"
                                                        Classes.IsPausePending="{Binding Status, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static sp:ServiceControllerStatus.PausePending}}"
                                                        Classes.IsPaused="{Binding Status, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static sp:ServiceControllerStatus.Paused}}">
                                                    <TextBlock Text="{Binding Status}" FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Margin="7,4" />
                                                </Border>

                                                <Border CornerRadius="8"
                                                        Classes.IsBoot="{Binding StartType, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static sp:ServiceStartMode.Boot}}"
                                                        Classes.IsSystem="{Binding StartType, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static sp:ServiceStartMode.System}}"
                                                        Classes.IsAutomatic="{Binding StartType, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static sp:ServiceStartMode.Automatic}}"
                                                        Classes.IsManual="{Binding StartType, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static sp:ServiceStartMode.Manual}}"
                                                        Classes.IsDisabled="{Binding StartType, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static sp:ServiceStartMode.Disabled}}">
                                                    <TextBlock Text="{Binding StartType}" FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Margin="7,4" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- TASKS LIST -->
                <ScrollViewer IsVisible="{Binding ActiveTab, Converter={StaticResource EqualityConverter}, ConverterParameter=1}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,0,-15,0">
                    <ItemsControl ItemsSource="{Binding Tasks}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Top">

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid>
                                    <Interaction.Behaviors>
                                        <behaviors:AdaptiveUniformGridBehavior
                                            MinItemWidth="320"
                                            MaxColumns="5" />
                                    </Interaction.Behaviors>
                                </UniformGrid>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Classes="SmallScale"
                                    Height="140"
                                    Background="Transparent"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Command="{Binding OpenTaskCommand}"
                                    Margin="0,0,5,5">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Open"
                                                      Command="{Binding OpenTaskCommand}" />
                                            <MenuItem Header="{Binding PinActionText}"
                                                      Command="{Binding TogglePinCommand}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Border CornerRadius="10"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Background="{StaticResource CardBackgroundBrush}">
                                        <Border.Styles>
                                            <Style Selector="Border.IsReady">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
                                            </Style>
                                            <Style Selector="Border.IsRunning">
                                                <Setter Property="Background" Value="{DynamicResource InfoBackgroundBrush}" />
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource InfoForegroundBrush}" />
                                            </Style>
                                            <Style Selector="Border.IsDisabled">
                                                <Setter Property="Background" Value="{DynamicResource DangerBackgroundBrush}" />
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" />
                                            </Style>
                                            <Style Selector="Border.IsQueued">
                                                <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningForegroundBrush}" />
                                            </Style>
                                            <Style Selector="Border.IsUnknown">
                                                <Setter Property="Background" Value="{DynamicResource NeutralBackgroundBrush}" />
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource NeutralForegroundBrush}" />
                                            </Style>
                                        </Border.Styles>
                                        <Grid RowDefinitions="Auto, Auto, *, Auto"
                                              Margin="15">
                                            <TextBlock Grid.Row="0"
                                                       Text="{Binding DisplayName}"
                                                       HorizontalAlignment="Stretch"
                                                       TextAlignment="Left"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontWeight="Medium"
                                                       FontSize="15"
                                                       Margin="0,0,24,0" />
                                            <Path Grid.Row="0"
                                                  Data="{StaticResource PinIcon}"
                                                  Fill="{DynamicResource SystemBaseHighColor}"
                                                  Height="16" Width="16"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Top"
                                                  Stretch="Uniform"
                                                  IsVisible="{Binding IsPinned}" />
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding TriggerSummary}"
                                                       HorizontalAlignment="Stretch"
                                                       TextAlignment="Left"
                                                       FontWeight="Light"
                                                       Foreground="{DynamicResource SystemBaseMediumColor}"
                                                       FontSize="10" />
                                            <StackPanel Grid.Row="2"
                                                        Orientation="Vertical"
                                                        Spacing="2"
                                                        Margin="0,6,0,0"
                                                        VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Description}"
                                                           HorizontalAlignment="Stretch"
                                                           TextWrapping="WrapWithOverflow"
                                                           TextTrimming="WordEllipsis"
                                                           TextAlignment="Left"
                                                           Foreground="{DynamicResource SystemBaseMediumColor}"
                                                           FontSize="12"
                                                           MaxHeight="32" />
                                                <StackPanel Orientation="Horizontal" Spacing="4"
                                                            IsVisible="{Binding NextRunTime, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                    <Viewbox Height="10">
                                                        <Path Data="{StaticResource ClockIcon}"
                                                              Fill="{DynamicResource SystemBaseMediumColor}"
                                                              Stretch="Uniform" />
                                                    </Viewbox>
                                                    <TextBlock Text="{Binding NextRunTime, StringFormat='{}{0:g}'}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource SystemBaseMediumColor}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Row="3"
                                                        Spacing="6"
                                                        Orientation="Horizontal"
                                                        Margin="0,8,0,0"
                                                        HorizontalAlignment="Stretch">
                                                <Border CornerRadius="8"
                                                        Classes.IsReady="{Binding Status, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static ts:TaskState.Ready}}"
                                                        Classes.IsRunning="{Binding Status, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static ts:TaskState.Running}}"
                                                        Classes.IsDisabled="{Binding Status, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static ts:TaskState.Disabled}}"
                                                        Classes.IsQueued="{Binding Status, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static ts:TaskState.Queued}}"
                                                        Classes.IsUnknown="{Binding Status, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static ts:TaskState.Unknown}}">
                                                    <TextBlock Text="{Binding Status}" FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Margin="7,4" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </Panel>
        </Grid>

        <controls:SlidePanel DataContext="{Binding SlidePanel}"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"
                             IsHitTestVisible="{Binding IsOpen}" />
    </Panel>
</Window>