<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SystemCtrl.Desktop.ViewModels"
             xmlns:sp="clr-namespace:System.ServiceProcess;assembly=System.ServiceProcess.ServiceController"
             xmlns:conv="using:SystemCtrl.Desktop.Converters"
             x:Class="SystemCtrl.Desktop.Views.ServiceDetailView"
             x:DataType="vm:ServiceDetailViewModel">

    <UserControl.Resources>
        <conv:EqualityConverter x:Key="EqualityConverter" />
        <conv:NullOrEmptyToUnknownConverter x:Key="ToUnknown" />
        <conv:CollectionEmptyConverter x:Key="CollectionEmpty" />
        <conv:CollectionNotEmptyConverter x:Key="CollectionNotEmpty" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.IsStopped">
            <Setter Property="Background" Value="{DynamicResource DangerBackgroundBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" />
        </Style>
        <Style Selector="Border.IsRunning">
            <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
        </Style>
        <Style Selector="Border.IsStartPending, Border.IsContinuePending">
            <Setter Property="Background" Value="{DynamicResource InfoBackgroundBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource InfoForegroundBrush}" />
        </Style>
        <Style Selector="Border.IsStopPending, Border.IsPausePending">
            <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningForegroundBrush}" />
        </Style>
        <Style Selector="Border.IsPaused">
            <Setter Property="Background" Value="{DynamicResource CautionBackgroundBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource CautionForegroundBrush}" />
        </Style>
        <Style Selector="Border.IsAutomatic">
            <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
        </Style>
        <Style Selector="Border.IsManual">
            <Setter Property="Background" Value="{DynamicResource NeutralBackgroundBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource NeutralForegroundBrush}" />
        </Style>
        <Style Selector="Border.IsDisabled">
            <Setter Property="Background" Value="{DynamicResource DangerBackgroundBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerForegroundBrush}" />
        </Style>
        <Style Selector="Border.IsBoot, Border.IsSystem">
            <Setter Property="Background" Value="{DynamicResource SpecialBackgroundBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource SpecialForegroundBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">
            <StackPanel Spacing="20"
                        Margin="20,0"
                        IsVisible="{Binding Service, Converter={x:Static ObjectConverters.IsNotNull}}">

                <!-- NAME -->
                <TextBlock Text="{Binding Service.DisplayName}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />

                <!-- SERVICE NAME -->
                <StackPanel Spacing="4">
                    <TextBlock Text="SERVICE NAME"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               LetterSpacing="1.2" />
                    <TextBlock Text="{Binding Service.ServiceName}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemBaseMediumHighColor}" />
                </StackPanel>

                <!-- STATE & STARTUP -->
                <StackPanel Spacing="8">
                    <TextBlock Text="STATE"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               LetterSpacing="1.2" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border CornerRadius="8"
                                Classes.IsStopped="{Binding Service.Status, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static sp:ServiceControllerStatus.Stopped}}"
                                Classes.IsStartPending="{Binding Service.Status, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static sp:ServiceControllerStatus.StartPending}}"
                                Classes.IsStopPending="{Binding Service.Status, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static sp:ServiceControllerStatus.StopPending}}"
                                Classes.IsRunning="{Binding Service.Status, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static sp:ServiceControllerStatus.Running}}"
                                Classes.IsContinuePending="{Binding Service.Status, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static sp:ServiceControllerStatus.ContinuePending}}"
                                Classes.IsPausePending="{Binding Service.Status, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static sp:ServiceControllerStatus.PausePending}}"
                                Classes.IsPaused="{Binding Service.Status, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static sp:ServiceControllerStatus.Paused}}">
                            <TextBlock Text="{Binding Service.Status}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="10,5" />
                        </Border>

                        <Border CornerRadius="8"
                                Classes.IsBoot="{Binding Service.StartType, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static sp:ServiceStartMode.Boot}}"
                                Classes.IsSystem="{Binding Service.StartType, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static sp:ServiceStartMode.System}}"
                                Classes.IsAutomatic="{Binding Service.StartType, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static sp:ServiceStartMode.Automatic}}"
                                Classes.IsManual="{Binding Service.StartType, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static sp:ServiceStartMode.Manual}}"
                                Classes.IsDisabled="{Binding Service.StartType, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static sp:ServiceStartMode.Disabled}}">
                            <TextBlock Text="{Binding Service.StartType}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="10,5" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- DESCRIPTION -->
                <StackPanel Spacing="4">
                    <TextBlock Text="DESCRIPTION"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               LetterSpacing="1.2" />
                    <TextBlock Text="{Binding Service.Description, Converter={StaticResource ToUnknown}}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemBaseMediumHighColor}" />
                </StackPanel>

                <!-- DETAILED INFO SECTION -->
                <Panel>
                    <!-- Loading indicator -->
                    <StackPanel IsVisible="{Binding IsLoadingDetails}"
                                Spacing="8"
                                HorizontalAlignment="Center"
                                Margin="0,8">
                        <ProgressBar IsIndeterminate="True"
                                     Width="160"
                                     Height="3"
                                     CornerRadius="2" />
                        <TextBlock Text="Loading details…"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource SystemBaseMediumColor}" />
                    </StackPanel>

                    <!-- Detailed fields -->
                    <StackPanel Spacing="20"
                                IsVisible="{Binding DetailedInfo, Converter={x:Static ObjectConverters.IsNotNull}}">

                        <!-- EXECUTABLE -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="EXECUTABLE"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemBaseMediumColor}"
                                       LetterSpacing="1.2" />
                            <TextBlock Text="{Binding DetailedInfo.ExecutableName, Converter={StaticResource ToUnknown}}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DetailedInfo.ExecutablePath}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Opacity="0.6"
                                       IsVisible="{Binding DetailedInfo.ExecutablePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Foreground="{DynamicResource SystemBaseMediumHighColor}" />
                        </StackPanel>

                        <!-- PUBLISHER -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="PUBLISHER"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemBaseMediumColor}"
                                       LetterSpacing="1.2" />
                            <TextBlock Text="{Binding DetailedInfo.Publisher, Converter={StaticResource ToUnknown}}"
                                       FontSize="13"
                                       Foreground="{DynamicResource SystemBaseMediumHighColor}" />
                        </StackPanel>

                        <!-- FILE VERSION & SIZE -->
                        <Grid ColumnDefinitions="*, 16, *">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="VERSION"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemBaseMediumColor}"
                                           LetterSpacing="1.2" />
                                <TextBlock Text="{Binding DetailedInfo.FileVersion, Converter={StaticResource ToUnknown}}"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SystemBaseMediumHighColor}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="FILE SIZE"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemBaseMediumColor}"
                                           LetterSpacing="1.2" />
                                <TextBlock Text="{Binding DetailedInfo.FileSizeFormatted, Converter={StaticResource ToUnknown}}"
                                           FontSize="13"
                                           Foreground="{DynamicResource SystemBaseMediumHighColor}" />
                            </StackPanel>
                        </Grid>

                        <!-- SERVICE ACCOUNT -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="SERVICE ACCOUNT"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemBaseMediumColor}"
                                       LetterSpacing="1.2" />
                            <TextBlock Text="{Binding DetailedInfo.ServiceAccount, Converter={StaticResource ToUnknown}}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SystemBaseMediumHighColor}" />
                        </StackPanel>

                        <!-- PROCESS ID -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="PROCESS ID"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemBaseMediumColor}"
                                       LetterSpacing="1.2" />
                            <TextBlock FontSize="13"
                                       Foreground="{DynamicResource SystemBaseMediumHighColor}">
                                <TextBlock.Text>
                                    <Binding Path="DetailedInfo.ProcessId"
                                             Converter="{StaticResource ToUnknown}" />
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>

                        <!-- DEPENDENCIES -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="DEPENDENCIES"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemBaseMediumColor}"
                                       LetterSpacing="1.2" />
                            <ItemsControl ItemsSource="{Binding DetailedInfo.Dependencies}"
                                          IsVisible="{Binding DetailedInfo.Dependencies, Converter={StaticResource CollectionNotEmpty}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6"
                                                Background="{DynamicResource NeutralBackgroundBrush}"
                                                Margin="0,0,0,4">
                                            <TextBlock Text="{Binding}"
                                                       FontSize="12"
                                                       Margin="8,4"
                                                       Foreground="{DynamicResource NeutralForegroundBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="None"
                                       FontSize="12"
                                       Foreground="{DynamicResource SystemBaseMediumColor}"
                                       IsVisible="{Binding DetailedInfo.Dependencies, Converter={StaticResource CollectionEmpty}}" />
                        </StackPanel>

                    </StackPanel>
                </Panel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>