<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SystemCtrl.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
             x:Class="SystemCtrl.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <Grid RowDefinitions="*, Auto, Auto"
          Margin="20,0,20,10">
        <ScrollViewer
            Classes="DefaultPadding"
            Grid.Row="0" VerticalScrollBarVisibility="Auto"
            Margin="0,0,-20,0"
            Padding="0,0,20,0">
            <StackPanel Spacing="25" Margin="0,0,0,20">
                <StackPanel Spacing="10">
                    <TextBlock Text="APPEARANCE"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <StackPanel Spacing="5">
                        <TextBlock Text="Theme" FontWeight="SemiBold" FontSize="14" />
                        <ComboBox ItemsSource="{Binding AvailableThemes}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  HorizontalAlignment="Stretch"
                                  CornerRadius="6"
                                  Padding="10"
                                  BorderThickness="0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="GEMINI AI"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <StackPanel Spacing="8">
                        <StackPanel Spacing="5">
                            <TextBlock Text="API Key" FontWeight="SemiBold" FontSize="14" />
                            <TextBox Text="{Binding ApiKey}"
                                     PasswordChar="•"
                                     PlaceholderText="Your GEMINI AI API Key"
                                     Classes="revealPasswordButton"
                                     CornerRadius="6"
                                     Padding="10"
                                     BorderThickness="0" />
                            <TextBlock Text="Your key is stored locally."
                                       FontSize="12"
                                       FontWeight="Light"
                                       Foreground="{DynamicResource SystemBaseMediumColor}" />
                        </StackPanel>
                        <StackPanel Spacing="5">
                            <TextBlock Text="Model" FontWeight="SemiBold" FontSize="14" />
                            <ComboBox ItemsSource="{Binding AvailableModels}"
                                      SelectedItem="{Binding SelectedModel}"
                                      HorizontalAlignment="Stretch"
                                      CornerRadius="6"
                                      Padding="10"
                                      BorderThickness="0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="PREFERENCES"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <StackPanel Spacing="5">
                        <CheckBox Content="Show AI Summary"
                                  IsChecked="{Binding ShowAiSummary}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="SERVICES"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <StackPanel Spacing="5">
                        <CheckBox Content="Disable Service Logs"
                                  IsChecked="{Binding DisableServiceLogs}" />
                        <CheckBox Content="Disable Service Resource Monitoring"
                                  IsChecked="{Binding DisableResourceUsage}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Text="TASKS"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <StackPanel Spacing="5">
                        <CheckBox Content="Disable Scheduled Tasks Logs"
                                  IsChecked="{Binding DisableScheduledTasksLogs}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1"
                Classes="SmallScale"
                Content="Save Settings"
                Command="{Binding SaveSettingsCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                CornerRadius="8"
                Padding="15"
                Background="{DynamicResource SystemBaseHighColor}"
                Foreground="{DynamicResource SystemAltHighColor}"
                FontWeight="Medium"
                FontSize="14" />
                
        <TextBlock Grid.Row="2"
                   Text="{Binding AppVersion}"
                   Margin="0,15,0,0"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource SystemBaseMediumColor}"
                   FontSize="11"
                   FontWeight="Light" />
    </Grid>
</UserControl>